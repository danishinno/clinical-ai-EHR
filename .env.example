# Email SMTP Configuration (Health Sync Clinical EHR)
# To enable LIVE email dispatch of Medical Certificates directly to actual inboxes:
# If using Gmail: Generate a 16-character App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_clinic_email@gmail.com
SMTP_PASS=your_16_digit_app_password
SMTP_FROM=your_clinic_email@gmail.com
